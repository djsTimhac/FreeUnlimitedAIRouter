# ─────────────────────────────────────────────────────────────────────────────
#  FreeUnlimitedAIRouter — copy this file to .env and fill in what you have.
#  Every provider is optional. Configure at least one.
# ─────────────────────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8787
# Protect the router itself. Leave empty for an open local instance.
ROUTER_API_KEY=
# DASHAUTH: if set, /v1/* and /api/* require "Authorization: Bearer <ROUTER_API_KEY>"

# Routing
DEFAULT_ALIAS=free
MAX_ATTEMPTS=6
CONNECT_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=180000
CORS_ORIGIN=*
LOG_LEVEL=info

# ── Free tiers first ────────────────────────────────────────────────────────

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Multiple keys? Comma- or newline-separated. The router rotates over them.
# OPENROUTER_API_KEYS=key_one,key_two

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# GitHub Models — a GitHub token with models:read (https://github.com/settings/tokens)
GITHUB_MODELS_TOKEN=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Together — https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ── Paid providers ──────────────────────────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# xAI — https://console.x.ai/
XAI_API_KEY=

# ── Local runtimes (no key needed) ──────────────────────────────────────────

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELS=llama3.2

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODELS=local-model

# ── Any other OpenAI-compatible server ──────────────────────────────────────
# Works for vLLM, LocalAI, llama.cpp server, OpenWebUI, a company proxy, ...
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=
CUSTOM_LABEL=Custom
